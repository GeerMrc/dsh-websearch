{
  "name": "dsh-websearch",
  "version": "0.4.0",
  "description": "Unified multi-provider WebSearch management plugin for the DeepSeek Harness (dsh) \u2014 priority chains with full HA degradation for search and fetch, plus a settings-page GUI",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "build:client": "tsdown -c tsdown.client.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "lint": "oxlint src tests",
    "check:i18n": "node scripts/check-locales.mjs && node scripts/check-cjk.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-alpha.3 <0.1.3",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.3 <0.1.3",
    "@deepseek-ai/dsh-web": ">=0.1.2-alpha.3 <0.1.3",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.3 <0.1.3",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3 <0.1.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.3 <0.1.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-web": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "jsdom": "~29.1.1",
    "oxlint": "1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
